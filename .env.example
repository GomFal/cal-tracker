DATABASE_URL=postgres://cal_tracker:cal_tracker@localhost:5432/cal_tracker
DATABASE_SCHEMA=public
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
SESSION_TOKEN_PEPPER=change-me-session-pepper-at-least-32-characters
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
STT_API_KEY=replace-with-groq-key
STT_MODEL=whisper-large-v3-turbo
STT_BASE_URL=https://api.groq.com/openai/v1
EMBEDDINGS_ENABLED=false
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSIONS=1024
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
TRUSTED_AUTO_COMMIT_THRESHOLD=0.92

# Admin telemetry panel auth. Store only an Argon2id hash in env.
# Generate with: cd apps/backend && printf '%s' "$LONG_ADMIN_PASSWORD" | bun run admin:hash-password
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD_HASH=$argon2id$v=19$m=...
ADMIN_PANEL_TOKEN_SECRET=change-me-admin-token-secret-at-least-32-characters
ADMIN_PANEL_TOKEN_TTL_SECONDS=1800
