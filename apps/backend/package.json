{
  "name": "@cal-tracker/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dist": "bun dist/scripts/migrate.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:custom": "drizzle-kit generate --config drizzle.config.ts --custom",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:dist": "bun dist/scripts/seed.js",
    "admin:hash-password": "tsx scripts/hash-admin-password.ts",
    "privacy:apply-suppressions": "tsx scripts/apply-privacy-suppressions.ts",
    "embed:foods": "tsx scripts/embed-food-items.ts",
    "food-quality": "tsx scripts/food-data-quality.ts",
    "food-normalization:sample": "tsx scripts/food-normalization-sample.ts",
    "food-normalization:backfill": "tsx scripts/food-normalized-search-backfill.ts",
    "food-normalization:reset-artifacts": "tsx scripts/food-normalization-reset-artifacts.ts",
    "food-normalization:long-name-review": "tsx scripts/food-normalization-long-name-review.ts",
    "benchmark:food-search": "tsx scripts/benchmark-food-search.ts",
    "validate:food-search-primary": "tsx scripts/validate-food-search-primary-position.ts",
    "benchmark:agent-foods": "tsx scripts/benchmark-agent-foods.ts",
    "generate:flutter-client": "tsx scripts/generate-flutter-client.ts"
  },
  "dependencies": {
    "@cal-tracker/contracts": "file:../../packages/contracts",
    "@hono/node-server": "^1.19.6",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "jose": "^6.1.2",
    "postgres": "^3.4.7",
    "resend": "^6.14.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
